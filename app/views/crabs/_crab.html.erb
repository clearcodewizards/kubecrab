<%# locals: (crab:) %>
  <li id="<%= dom_id(crab) %>" class="relative flex justify-between gap-x-6 px-4 py-5 sm:px-6 hover:bg-gray-50 dark:hover:bg-white/2.5">
    <div class="flex min-w-0 gap-x-4">
      <%= image_tag crab.template.avatar, class: "size-12 flex-none rounded-md bg-gray-50 dark:bg-gray-800 dark:outline dark:-outline-offset-1 dark:outline-white/10" if crab.template.avatar.attached? %>
      <div class="min-w-0 flex-auto">
        <p class="text-sm/6 font-semibold text-gray-900 dark:text-white">
            <%= crab.name %>.<%= crab.template.base_url %>
        </p>
        <p class="mt-1 flex text-xs/5 text-gray-500 dark:text-gray-400">
          <%= crab.template.name %>
          <svg viewBox="0 0 2 2" class="mx-2 mt-2 size-1 fill-gray-400">
            <circle r="1" cx="1" cy="1" />
          </svg>
          <%= crab.user.email %>
        </p>
      </div>
    </div>
    <div class="flex shrink-0 items-center gap-x-4">
      <% if crab.running? %>
        <%= link_to "Go to Crab", "https://#{crab.name}.#{crab.template.base_url}", target: "_blank", class: css_button %>
      <% else %>
        <%= link_to "#", class: css_button do %>
          <span><%= crab.status %></span>
          <svg class="ml-2 size-4 animate-spin fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.14,1.16a11,11,0,0,0-9,8.92A1.59,1.59,0,0,0,2.46,12,1.52,1.52,0,0,0,4.11,10.7a8,8,0,0,1,6.66-6.61A1.42,1.42,0,0,0,12,2.69h0A1.57,1.57,0,0,0,10.14,1.16Z" />
          </svg>
        <% end %>
      <% end %>
      <%= link_to "Edit", crab_path(crab), class: css_button %>
    </div>
  </li>
