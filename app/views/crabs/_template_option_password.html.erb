<%# locals: (option:) %>
        <div class="sm:col-span-full" data-controller="password">
          <%= label_tag "crab_#{option.name}", option.name, class: css_label %>
          <div class="relative mt-2">
            <div class="absolute inset-y-0 right-0 flex items-center px-1">
              <button data-action="password#toggle" data-password-target="toggle" class="hidden <%= css_button_small %>" tabindex="-1">
                <span class="sr-only">Toggle visibility</span>

                <%= heroicon "eye", variant: :solid, options: {class: "h-4 w-4"} %>
                <%= heroicon "eye-slash", variant: :solid, options: {class: "hidden h-4 w-4"} %>
              </button>
            </div>
            <input type="password" id="crab_<%= option.name %>" name="crab[options][<%= option.name %>]" value="<%= @crab.options[option.name] if @crab.options.present? %>" autocomplete="none" class="<%= css_password %>" data-password-target="password">
          </div>
        </div>
